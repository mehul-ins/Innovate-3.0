<section id="login-section">
  <div class="container">
    <h2>Login</h2>
    <form id="login-form">
      <div class="form-group">
        <label>Email:</label>
        <input type="email" id="login-email" required />
      </div>
      <div class="form-group">
        <label>Password:</label>
        <input type="password" id="login-password" required />
      </div>
      <button type="submit">Login</button>
      <div id="login-error" class="error"></div>
    </form>

    <div class="quick-login">
      <h3>Quick Login (Demo)</h3>
      <button onclick="quickLogin('admin@test.com', 'password123')">Login as ADMIN</button>
      <button onclick="quickLogin('supplier@test.com', 'password123')">Login as SUPPLIER</button>
      <button onclick="quickLogin('lender@test.com', 'password123')">Login as LENDER</button>
    </div>
  </div>
</section>

